<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="mainBorderPane"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="application.controller.MainViewController"
            prefWidth="1200"
            prefHeight="750"
            style="-fx-background-color: #f5f5f5;">

    <top>
        <VBox>
            <HBox spacing="12"
                  alignment="CENTER_LEFT"
                  style="-fx-background-color: #1F4D2B;">
                <padding>
                    <Insets top="10" right="20" bottom="10" left="20"/>
                </padding>

                <Label text="Home Improvement Empire"
                       style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;"/>

                <Region HBox.hgrow="ALWAYS"/>

                <TextField fx:id="searchField"
                           promptText="Search products"
                           prefWidth="350"/>

                <Button text="Search" onAction="#handleSearch"/>
                <Button text="Sort Price" onAction="#handleSortByPrice"/>
                <Button text="In Stock First" onAction="#handleSortByAvailability"/>

                <Button fx:id="cartButton"
                        text="Cart (0)"
                        onAction="#handleShowCart"
                        style="-fx-font-weight: bold;"/>
            </HBox>

            <Label text="Featured Products"
                   style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-padding: 18 0 8 30;"/>
        </VBox>
    </top>

    <center>
        <ScrollPane fx:id="catalogScrollPane"
                    fitToWidth="true"
                    style="-fx-background-color: transparent;">
            <content>
                <TilePane fx:id="productTilePane"
                          hgap="25"
                          vgap="25"
                          prefColumns="4">
                    <padding>
                        <Insets top="15" right="30" bottom="30" left="30"/>
                    </padding>
                </TilePane>
            </content>
        </ScrollPane>
    </center>

    <bottom>
        <Label fx:id="messageLabel"
               text=""
               wrapText="true"
               style="-fx-padding: 10 20 15 20; -fx-text-fill: #333333;"/>
    </bottom>

</BorderPane>