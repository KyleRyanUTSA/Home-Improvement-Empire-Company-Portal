<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="application.controller.CheckoutController"
      spacing="12"
      prefWidth="900"
      prefHeight="650"
      style="-fx-background-color: white;">

    <padding>
        <Insets top="20"
                right="25"
                bottom="20"
                left="25"/>
    </padding>

    <Label text="Checkout"
           style="-fx-font-size: 26px; -fx-font-weight: bold;"/>

    <Label text="Review the items in your cart:"
           style="-fx-text-fill: #555555;"/>

    <TableView fx:id="cartTable"
               prefHeight="420"
               VBox.vgrow="ALWAYS">

        <columns>
            <TableColumn fx:id="itemNameColumn"
                         text="Product"
                         prefWidth="350"/>

            <TableColumn fx:id="quantityColumn"
                         text="Quantity"
                         prefWidth="110"/>

            <TableColumn fx:id="priceColumn"
                         text="Price"
                         prefWidth="140"/>

            <TableColumn fx:id="totalColumn"
                         text="Item Total"
                         prefWidth="150"/>
        </columns>
    </TableView>

    <HBox spacing="8"
          alignment="CENTER_LEFT">

        <TextField fx:id="promoCodeField"
                   promptText="Promo code"
                   prefWidth="170"/>

        <Button fx:id="applyPromoButton"
                text="Apply"
                onAction="#handleApplyPromo"/>
    </HBox>

    <VBox spacing="8" style="-fx-padding: 10; -fx-background-color: #F5F7F5; -fx-background-radius: 6;">
        <Label text="Delivery Option" style="-fx-font-weight: bold;"/>
        <HBox spacing="18" alignment="CENTER_LEFT">
            <RadioButton fx:id="pickupRadioButton"
                         text="Store Pickup (Free)"
                         selected="true"
                         onAction="#handleDeliveryOptionChanged">
                <toggleGroup>
                    <ToggleGroup fx:id="deliveryToggleGroup"/>
                </toggleGroup>
            </RadioButton>
            <RadioButton fx:id="standardDeliveryRadioButton"
                         text="Standard Delivery (\$9.99)"
                         toggleGroup="$deliveryToggleGroup"
                         onAction="#handleDeliveryOptionChanged"/>
            <RadioButton fx:id="expressDeliveryRadioButton"
                         text="Express Delivery (\$24.99)"
                         toggleGroup="$deliveryToggleGroup"
                         onAction="#handleDeliveryOptionChanged"/>
        </HBox>
    </VBox>

    <VBox spacing="6" alignment="CENTER_RIGHT">
        <HBox spacing="20" alignment="CENTER_RIGHT">
            <Label text="Subtotal:" prefWidth="110"/>
            <Label fx:id="subtotalLabel" text="\$0.00" prefWidth="90"/>
        </HBox>
        <HBox spacing="20" alignment="CENTER_RIGHT">
            <Label text="Discount:" prefWidth="110"/>
            <Label fx:id="discountLabel" text="-\$0.00" prefWidth="90" style="-fx-text-fill: #1F7A3F;"/>
        </HBox>
        <HBox spacing="20" alignment="CENTER_RIGHT">
            <Label text="Delivery:" prefWidth="110"/>
            <Label fx:id="deliveryFeeLabel" text="\$0.00" prefWidth="90"/>
        </HBox>
        <HBox spacing="20" alignment="CENTER_RIGHT">
            <Label text="Tax:" prefWidth="110"/>
            <Label fx:id="taxLabel" text="\$0.00" prefWidth="90"/>
        </HBox>
        <HBox spacing="20" alignment="CENTER_RIGHT">
            <Label text="Total:" prefWidth="110" style="-fx-font-weight: bold;"/>
            <Label fx:id="totalLabel" text="\$0.00" prefWidth="90" style="-fx-font-weight: bold; -fx-font-size: 16px;"/>
        </HBox>
    </VBox>

    <Region VBox.vgrow="ALWAYS"/>

    <HBox spacing="10"
          alignment="CENTER_RIGHT">

        <Button fx:id="continueShoppingButton"
                text="Return to Cart"
                onAction="#handleContinueShopping"/>

        <Button fx:id="cancelButton"
                text="Cancel"
                onAction="#handleCancel"/>

        <Button fx:id="completeCheckoutButton"
                text="Complete Checkout"
                onAction="#handleCompleteCheckout"
                style="-fx-background-color: #1F4D2B;
                       -fx-text-fill: white;
                       -fx-font-weight: bold;"/>
    </HBox>

</VBox>
