<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="650" prefWidth="900" spacing="12" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="application.controller.CheckoutController">

    <padding>
        <Insets bottom="20" left="25" right="25" top="20" />
    </padding>

    <Label style="-fx-font-size: 26px; -fx-font-weight: bold;" text="Checkout" />

    <Label style="-fx-text-fill: #555555;" text="Review the items in your cart:" />

    <TableView fx:id="cartTable" prefHeight="420" VBox.vgrow="ALWAYS">

        <columns>
            <TableColumn fx:id="itemNameColumn" prefWidth="350" text="Product" />

            <TableColumn fx:id="quantityColumn" prefWidth="110" text="Quantity" />

            <TableColumn fx:id="priceColumn" prefWidth="140" text="Price" />

            <TableColumn fx:id="totalColumn" prefWidth="150" text="Item Total" />
        </columns>
    </TableView>

    <HBox alignment="CENTER_LEFT" spacing="8">

        <TextField fx:id="promoCodeField" prefWidth="170" promptText="Promo code" />

        <Button fx:id="applyPromoButton" onAction="#handleApplyPromo" text="Apply" />
    </HBox>

    <VBox spacing="8" style="-fx-padding: 10; -fx-background-color: #F5F7F5; -fx-background-radius: 6;">
        <Label style="-fx-font-weight: bold;" text="Delivery Option" />
        <HBox alignment="CENTER_LEFT" spacing="18">
            <RadioButton fx:id="pickupRadioButton" onAction="#handleDeliveryOptionChanged" selected="true" text="Store Pickup (Free)">
                <toggleGroup>
                    <ToggleGroup fx:id="deliveryToggleGroup" />
                </toggleGroup>
            </RadioButton>
            <RadioButton fx:id="standardDeliveryRadioButton" onAction="#handleDeliveryOptionChanged" text="Standard Delivery ($9.99)" toggleGroup="$deliveryToggleGroup" />
            <RadioButton fx:id="expressDeliveryRadioButton" onAction="#handleDeliveryOptionChanged" text="Express Delivery ($24.99)" toggleGroup="$deliveryToggleGroup" />
        </HBox>
    </VBox>

    <VBox alignment="CENTER_RIGHT" spacing="6">
        <HBox alignment="CENTER_RIGHT" spacing="20">
            <Label prefWidth="110" text="Subtotal:" />
            <Label fx:id="subtotalLabel" prefWidth="90" text="\$0.00" />
        </HBox>
        <HBox alignment="CENTER_RIGHT" spacing="20">
            <Label prefWidth="110" text="Discount:" />
            <Label fx:id="discountLabel" prefWidth="90" style="-fx-text-fill: #1F7A3F;" text="-\$0.00" />
        </HBox>
        <HBox alignment="CENTER_RIGHT" spacing="20">
            <Label fx:id="deliveryLabel" prefWidth="110" text="Delivery:" />
            <Label fx:id="deliveryFeeLabel" prefWidth="90" text="\$0.00" />
        </HBox>
        <HBox alignment="CENTER_RIGHT" spacing="20">
            <Label prefWidth="110" text="Tax:" />
            <Label fx:id="taxLabel" prefWidth="90" text="\$0.00" />
        </HBox>
        <HBox alignment="CENTER_RIGHT" spacing="20">
            <Label prefWidth="110" style="-fx-font-weight: bold;" text="Total:" />
            <Label fx:id="totalLabel" prefWidth="90" style="-fx-font-weight: bold; -fx-font-size: 16px;" text="\$0.00" />
        </HBox>
    </VBox>

    <Region VBox.vgrow="ALWAYS" />

    <HBox alignment="CENTER_RIGHT" spacing="10">

        <Button fx:id="continueShoppingButton" onAction="#handleContinueShopping" text="Return to Cart" />

        <Button fx:id="cancelButton" onAction="#handleCancel" text="Cancel" />

        <Button fx:id="completeCheckoutButton" onAction="#handleCompleteCheckout" style="-fx-background-color: #1F4D2B;                        -fx-text-fill: white;                        -fx-font-weight: bold;" text="Complete Checkout" />
    </HBox>

</VBox>
