<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="mainBorderPane"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="application.controller.MainViewController"
            prefWidth="1200"
            prefHeight="750"
            style="-fx-background-color: #f5f5f5;">

    <!-- Top navigation and product controls -->
    <top>
        <VBox>

            <!-- Main navigation bar -->
            <HBox alignment="CENTER_LEFT"
                  spacing="12"
                  style="-fx-background-color: #1F4D2B;">

                <padding>
                    <Insets top="12"
                            right="20"
                            bottom="12"
                            left="20"/>
                </padding>

                <Label text="Home Improvement Empire"
                       style="-fx-text-fill: white;
                              -fx-font-size: 24px;
                              -fx-font-weight: bold;"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Button
                        text="Order History"
                        onAction="#handleShowOrderHistory"
                        style="-fx-background-color: #dddddd;
               -fx-text-fill: #222222;
               -fx-font-weight: bold;
               -fx-background-radius: 6;" />

                <Button
                        fx:id="profileButton"
                        text="Profile"
                        onAction="#handleShowProfile"
                        style="-fx-background-color: #dddddd;
               -fx-text-fill: #222222;
               -fx-font-weight: bold;
               -fx-background-radius: 6;" />

                <Button text="Log Out"
                        onAction="#handleLogout"
                        style="-fx-background-color: #dddddd;
                               -fx-text-fill: #222222;
                               -fx-font-weight: bold;
                               -fx-background-radius: 5;"/>

                <Button fx:id="cartButton"
                        text="Cart (0)"
                        onAction="#handleShowCart"
                        style="-fx-background-color: #FFD814;
                               -fx-text-fill: #222222;
                               -fx-font-weight: bold;
                               -fx-background-radius: 5;"/>
            </HBox>

            <!-- Search, category, and sorting controls -->
            <VBox spacing="12"
                  style="-fx-background-color: white;
                         -fx-border-color: transparent transparent #dddddd transparent;">

                <padding>
                    <Insets top="16"
                            right="30"
                            bottom="16"
                            left="30"/>
                </padding>

                <HBox alignment="CENTER_LEFT"
                      spacing="12">

                    <Label text="Browse Products"
                           style="-fx-font-size: 21px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #222222;"/>

                    <Region HBox.hgrow="ALWAYS"/>

                    <TextField fx:id="searchField"
                               promptText="Search by name, description, or category"
                               prefWidth="330"
                               onAction="#handleSearch"
                               style="-fx-background-radius: 5;
                                      -fx-border-radius: 5;
                                      -fx-border-color: #bbbbbb;"/>

                    <Button text="Search"
                            onAction="#handleSearch"
                            style="-fx-background-color: #1F4D2B;
                                   -fx-text-fill: white;
                                   -fx-font-weight: bold;
                                   -fx-background-radius: 5;"/>
                </HBox>

                <HBox alignment="CENTER_LEFT"
                      spacing="12">

                    <Label text="Category:"
                           style="-fx-font-weight: bold;
                                  -fx-text-fill: #333333;"/>

                    <ComboBox fx:id="categoryComboBox"
                              promptText="All Categories"
                              prefWidth="180"
                              onAction="#handleCategoryFilter"
                              style="-fx-background-radius: 5;"/>

                    <Label text="Sort:"
                           style="-fx-font-weight: bold;
                                  -fx-text-fill: #333333;"/>

                    <ComboBox fx:id="sortComboBox"
                              promptText="Sort Products"
                              prefWidth="190"
                              onAction="#handleSortSelection"
                              style="-fx-background-radius: 5;"/>

                    <Button text="Clear Filters"
                            onAction="#handleClearFilters"
                            style="-fx-background-color: #e6e6e6;
                                   -fx-text-fill: #222222;
                                   -fx-font-weight: bold;
                                   -fx-background-radius: 5;"/>

                    <Region HBox.hgrow="ALWAYS"/>

                    <Label text="Double-click a product to add it to the cart."
                           style="-fx-text-fill: #666666;
                                  -fx-font-size: 12px;"/>
                </HBox>
            </VBox>
        </VBox>
    </top>

    <!-- Product catalog -->
    <center>
        <ScrollPane fx:id="catalogScrollPane"
                    fitToWidth="true"
                    pannable="true"
                    hbarPolicy="NEVER"
                    style="-fx-background-color: transparent;
                           -fx-background: transparent;">

            <content>
                <TilePane fx:id="productTilePane"
                          hgap="25"
                          vgap="25"
                          prefColumns="4"
                          alignment="TOP_LEFT"
                          style="-fx-background-color: #f5f5f5;">

                    <padding>
                        <Insets top="25"
                                right="30"
                                bottom="35"
                                left="30"/>
                    </padding>
                </TilePane>
            </content>
        </ScrollPane>
    </center>

    <!-- Status message -->
    <bottom>
        <HBox alignment="CENTER_LEFT"
              style="-fx-background-color: white;
                     -fx-border-color: #dddddd transparent transparent transparent;">

            <padding>
                <Insets top="12"
                        right="20"
                        bottom="12"
                        left="20"/>
            </padding>

            <Label fx:id="messageLabel"
                   text=""
                   wrapText="true"
                   style="-fx-text-fill: #333333;
                          -fx-font-size: 13px;"/>
        </HBox>
    </bottom>

</BorderPane>